<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F4F6F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inspection Report"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/edtInspectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Inspection Title"
            android:padding="10dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/edtInspectorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Inspector Name"
            android:padding="10dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/edtInspectionDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Inspection Date (DD/MM/YYYY)"
            android:padding="10dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="10dp"
            android:inputType="date"/>

        <EditText
            android:id="@+id/edtRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Remarks"
            android:padding="10dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="10dp"
            android:minLines="3"
            android:maxLines="5"/>

        <Button
            android:id="@+id/btnSubmitInspection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit Report"
            android:background="@color/purple_500"
            android:textColor="#FFF"
            android:layout_marginTop="20dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
</ScrollView>
